<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>w3_go2_sim</name>
  <version>0.1.0</version>
  <description>Warsztat W3 (wariant Go2): Unitree Go2 (CHAMP) w Gazebo Harmonic - SLAM (slam_toolbox), zapis mapy, Nav2 z AMCL</description>
  <maintainer email="lucs.robotics@gmail.com">LucsRobotics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Model Go2 i kontroler CHAMP (unitree_go2_description, unitree_go2_sim, champ_base,
       unitree_application) pochodzą z repo khaledgabr77/unitree_go2_ros2, które kursant
       klonuje obok (README). Celowo NIE jako zależności: bez tego repo rosdep na całym
       repo ćwiczeń kończyłby się błędem „cannot resolve”. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
