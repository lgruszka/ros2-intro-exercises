<?xml version="1.0" ?>
<!-- Sala warsztatowa W3 (Go2 w Gazebo): 12 x 10 m, ściany 1,5 m, kilka przeszkód.
     Robot startuje w (0, 0). Ściany są wyższe niż wiązki lidaru Velodyne (±15°). -->
<sdf version="1.8">
  <world name="default">
    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>52.2297</latitude_deg>
      <longitude_deg>21.0122</longitude_deg>
      <elevation>100.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.1 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 0.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.1 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 0.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 0.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>6.1 0 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.0 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-6.1 0 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.0 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.0 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="partition">
      <static>true</static>
      <pose>1.5 3.25 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.5 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 3.5 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="partition_2">
      <static>true</static>
      <pose>-3.0 -1.0 0.75 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.5 0.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.5 0.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_a">
      <static>true</static>
      <pose>3.5 0.5 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_b">
      <static>true</static>
      <pose>-2.0 3.0 0.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.6 1.0</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_c">
      <static>true</static>
      <pose>0.5 -3.5 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.6 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 1.0</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.7 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_a">
      <static>true</static>
      <pose>3.0 -2.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.8 0.45 0.2 1</ambient><diffuse>0.8 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_b">
      <static>true</static>
      <pose>-4.5 1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.8 0.45 0.2 1</ambient><diffuse>0.8 0.45 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
