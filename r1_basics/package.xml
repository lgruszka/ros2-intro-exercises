<?xml version="1.0"?>
<package format="3">
  <name>r1_basics</name>
  <version>0.1.0</version>
  <description>Unitree R1 EDU w ROS 2 Jazzy (W9/W10): most /cmd_vel -&gt; sport API, odometria zliczeniowa,
    dojazd do punktu, ręce/głowa przez arm_sdk, kamera GStreamer -&gt; Image, makieta robota r1_mock.
    Kurs ROS 2 Intro (LucsRobotics).</description>
  <maintainer email="lucs.robotics@gmail.com">LucsRobotics</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- tf2_ros dla Pythona (TransformBroadcaster) to na Jazzy pakiet tf2_ros_py -->
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- msgs Unitree z unitree_ros2 (cyclonedds_ws/src/unitree), budowane w tym samym workspace: -->
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>unitree_hg</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
