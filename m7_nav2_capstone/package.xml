<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>m7_nav2_capstone</name>
  <version>0.2.0</version>
  <description>Warsztat W3 — Nav2 i SLAM w Webots z TurtleBot3: node scan_fix (odwrócony /scan z Webots), launch SLAM i parametry Nav2</description>
  <maintainer email="lucs.robotics@gmail.com">LucsRobotics</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <!-- webots_ros2_turtlebot celowo NIE jako zależność: Webots jest tylko na amd64,
       a rosdep na arm64 (Mac/Docker) wywracałby się na całym repo ćwiczeń.
       Instalacja warstwy W3: strona W3 kursu, ramka „Instalacja warstwy W3”. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
